   "diseased_leaves": {
    "n": 120,
    "reported_problem": 105,
    "reported_healthy": 8,
    "uncertain": 7
   }
  },
  "note": "Field figures include AgriGuard's confidence policy and leaf-only health guard. Small field test set; re-measure on local photos before claiming accuracy."
 },
 "training_data": [
  {
   "name": "PlantVillage (spMohanty/PlantVillage-Dataset)",
   "license": "CC BY-SA 3.0",
   "use": "up to 400 lab images per class + augmentation"
  },
  {
   "name": "PlantDoc (pratikkayal/PlantDoc-Dataset)",
   "license": "CC BY 4.0",
   "use": "field images, train split; test split held out"
  }
 ],
 "backbone": {
  "name": "MobileNetV2-12, ONNX Model Zoo",
  "license": "Apache-2.0"
 }
}