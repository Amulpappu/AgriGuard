{
  "version": "agriguard-leaf-v2",
  "created": "2026-10-16",
  "architecture": "MobileNetV2 (ImageNet, ONNX Model Zoo) + 256-unit MLP head",
  "input": {
    "name": "input",
    "shape": [
      1,
      3,
      224,
      224
    ],
    "layout": "NCHW",
    "resize_short_side": 256,
    "center_crop": 224,
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "output": "logits (apply softmax)",
  "classes": [
    "apple_black_rot",
    "apple_cedar_rust",
    "apple_healthy",
    "apple_scab",
    "cherry_healthy",
    "cherry_powdery_mildew",
    "corn_common_rust",
    "corn_gray_leaf_spot",
    "corn_healthy",
    "corn_leaf_blight",
    "cotton_healthy",
    "cotton_leaf_disease",
    "grape_black_rot",
    "grape_esca",
    "grape_healthy",
    "grape_leaf_blight",
    "orange_citrus_greening",
    "peach_bacterial_spot",
    "peach_healthy",
    "pepper_bacterial_spot",
    "pepper_healthy",
    "potato_early_blight",
    "potato_healthy",
    "potato_late_blight",
    "rice_bacterial_leaf_blight",
    "rice_brown_spot",
    "rice_leaf_smut",
    "soybean_healthy",
    "squash_powdery_mildew",
    "strawberry_healthy",
    "strawberry_leaf_scorch",
    "tomato_bacterial_spot",
    "tomato_early_blight",
    "tomato_healthy",
    "tomato_late_blight",
    "tomato_leaf_mold",
    "tomato_mosaic_virus",
    "tomato_septoria_leaf_spot",
    "tomato_spider_mites",
    "tomato_target_spot",
    "tomato_yellow_leaf_curl_virus",
    "other_leaf"
  ],
  "crops": [
    "apple",
    "cherry",
    "corn",
    "cotton",
    "grape",
    "orange",
    "peach",
    "pepper",
    "potato",
    "rice",
    "soybean",
    "squash",
    "strawberry",
    "tomato"
  ],
  "metrics": {
    "plantvillage_lab_holdout": {
      "images": 3600,
      "accuracy_crop_selected": 0.963,
      "crop_auto_detect": 0.988
    },
    "plantdoc_field_test": {
      "images": 218,
      "accuracy_crop_selected": 0.716,
      "healthy_leaves": {
        "n": 72,
        "reported_healthy": 67,
        "reported_disease": 3,
        "uncertain": 2
      },
      "diseased_leaves": {
        "n": 140,
        "reported_problem": 125,
        "reported_healthy": 8,
        "uncertain": 7
      }
    },
    "plantdoc_field_test_original_5_crops": {
      "images": 148,
      "accuracy_crop_selected": 0.608,
      "note": "v1 was 0.615 on the same photos"
    },
    "rice_holdout": {
      "images": 30,
      "accuracy_crop_selected": 0.733,
      "note": "diseased leaves only; no healthy rice photos in the data"
    },
    "cotton_val": {
      "images": 324,
      "accuracy_crop_selected": 0.969,
      "note": "same photo collection as training - optimistic"
    },
    "per_crop_lab_accuracy": {
      "apple": 0.988,
      "cherry": 1.0,
      "corn": 0.927,
      "grape": 0.985,
      "orange": 1.0,
      "peach": 0.995,
      "pepper": 0.99,
      "potato": 0.967,
      "soybean": 1.0,
      "squash": 1.0,
      "strawberry": 0.99,
      "tomato": 0.922
    },
    "note": "Field figures include AgriGuard's confidence policy and leaf-only health guard. Small field test sets; re-measure on local photos before claiming accuracy."
  },
  "training_data": [
    {
      "name": "PlantVillage (spMohanty/PlantVillage-Dataset)",
      "license": "CC BY-SA 3.0",
      "use": "up to 400 lab images per class (14 crops; blueberry and raspberry used as other_leaf) + augmentation"
    },
    {
      "name": "PlantDoc (pratikkayal/PlantDoc-Dataset)",
      "license": "CC BY 4.0",
      "use": "field images, train split; test split held out"
    },
    {
      "name": "Rice Leaf Diseases (UCI ML Repository #486, Prajapati et al., India)",
      "license": "CC BY 4.0",
      "use": "30 photos per class for training (+8 augmented copies), 10 held out",
      "source": "github.com/PawarMukesh/RiceLeaf-Disease-Detector (copy of the UCI set)"
    },
    {
      "name": "Cotton Disease dataset (collected by Akash Zade, India)",
      "license": "not stated by the author - research/prototype use only; replace before commercial use",
      "use": "up to 250 photos per folder (+1 augmented copy); val split held out",
      "source": "github.com/auchinto-c/Cotton-Disease-Prediction"
    }
  ],
  "backbone": {
    "name": "MobileNetV2-12, ONNX Model Zoo",
    "license": "Apache-2.0"
  },
  "crops_without_healthy_class": [
    "rice"
  ]
}