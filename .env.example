# ─── Application ───────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-32-chars-min-replace-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ───────────────────────────────────────────────────────
# SQLite (dev default):
DATABASE_URL=sqlite+aiosqlite:///./agriguard.db
# PostgreSQL (prod):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agriguard

# ─── Storage ────────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ─── ML ─────────────────────────────────────────────────────────────
MODEL_BACKEND=mock          # mock | torch
MODEL_PATH=app/ml/weights/model.pt
MODEL_META_PATH=app/ml/weights/model_meta.json

# ─── Confidence Thresholds ──────────────────────────────────────────
CONF_CONFIDENT=0.80
CONF_POSSIBLE=0.55
CONF_MARGIN=0.15

# ─── Severity Thresholds (%) ────────────────────────────────────────
SEVERITY_LOW=10
SEVERITY_MODERATE=30

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── IoT ────────────────────────────────────────────────────────────
DEVICE_KEY_HASH=                # sha256 hex of your device key

# ─── Frontend (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LANG=en
